# Server-side only (Vercel project env var / local .env.local). Never prefix with VITE_.
TYPESAFE_API_KEY=
# Postgres connection string (Neon). Unset in local dev to use in-process PGlite.
DATABASE_URL=
# Shared secret for /api/cron/ingest (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Optional overrides
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# Client: absolute API origin, required for the native (Capacitor) builds.
# VITE_API_BASE=https://your-app.vercel.app
